<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>WSystem.EInvoice</RootNamespace>
    <AssemblyName>WSystem.EInvoice</AssemblyName>
    <PackageId>WSystem.EInvoice</PackageId>
    <Version>0.9.0-beta.2</Version>
    <Authors>W System</Authors>
    <Company>W System</Company>
    <Product>W System e-invoice SDK for .NET</Product>
    <Copyright>Copyright 2026 W System</Copyright>
    <Description>Create and validate (pre-check) EU e-invoices locally in .NET: XRechnung 3.0 (UBL and CII), EN 16931 UBL/CII, ZUGFeRD 2.3 / Factur-X 1.07 PDF/A-3b and credit notes. Offline, no API key, Apache-2.0. Optional official validation through the W System validator or API.</Description>
    <PackageTags>xrechnung;zugferd;factur-x;en16931;e-invoice;e-rechnung;einvoice;ubl;cii;kosit;schematron;peppol;pdfa3</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://wsystem.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wsystemdev/einvoice-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" LogicalName="WSystem.EInvoice.Resources/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="WSystem.EInvoice.Tests" />
  </ItemGroup>
</Project>
